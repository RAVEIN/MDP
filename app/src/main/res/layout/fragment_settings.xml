<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">


        <TextView
            android:id="@+id/textGameSpeed"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Скорость игры: 5"

            android:textSize="18sp" />


        <SeekBar
            android:id="@+id/seekGameSpeed"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:min="1"
            android:max="10"

            android:progress="5" />


        <TextView
            android:id="@+id/textMaxBugs"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Максимум жуков: 10"

            android:textSize="18sp" />


        <SeekBar
            android:id="@+id/seekMaxBugs"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:min="1"
            android:max="20"

            android:progress="10" />


        <TextView
            android:id="@+id/textBonusInterval"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Интервал бонусов: 15 сек."

            android:textSize="18sp" />


        <SeekBar
            android:id="@+id/seekBonusInterval"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:min="5"
            android:max="60"

            android:progress="15" />


        <TextView
            android:id="@+id/textRoundDuration"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Длительность раунда: 60 сек."

            android:textSize="18sp" />


        <SeekBar
            android:id="@+id/seekRoundDuration"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:min="30"
            android:max="300"

            android:progress="60" />


    </LinearLayout>

</ScrollView>